APP_NAME="Auction Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL runs in Docker (docker compose up -d) on host port 3307.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=auction
DB_USERNAME=auction
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

# The SPA origin(s) that receive stateful (cookie) authentication.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@auction.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Bid engine: max seconds a bid waits for the auction row lock, and retries
# after a lock timeout/deadlock before answering 409 BID_CONFLICT_RETRY.
AUCTION_BID_LOCK_WAIT_SECONDS=5
AUCTION_BID_TRANSACTION_ATTEMPTS=3

# Laravel Reverb (WebSockets). Generate your own id/key/secret for real deployments.
REVERB_APP_ID=auction-local
REVERB_APP_KEY=auction-local-key
REVERB_APP_SECRET=auction-local-secret
# Where the backend publishes events (inside Docker this is the "reverb" service).
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# Browser origins (hosts) allowed to open WebSocket connections.
REVERB_ALLOWED_ORIGINS=localhost
